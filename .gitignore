# Dependencies — installed via npm install
node_modules/

# Environment variables file — contains secret bot token
.env

# OS generated files
.DS_Store
Thumbs.db

# Temporary Microsoft Office / Excel lock files created when files are open in Excel
~$*

# IDE / editor files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
# What this line does: Ignores Vercel project linkage and build metadata
# What it brings: Prevents local Vercel CLI cache files from polluting git history
# Where changes can be seen: Git staging and repository tracking
.vercel

# What this line does: Ignores all environment variable files and backups (.env, .env.local, .env.production)
# What it brings: Completely prevents secrets, tokens, and keys from being accidentally committed
# Where changes can be seen: Git status and commit trees
.env*

# Which subjects autopilot was posting when the server last stopped. Local
# runtime state, rebuilt from the dashboard — never shared between machines.
.autopilot-state.json
