# ============================================================================
# Sadhana APPSC Telegram Automation — environment variables
# ============================================================================
# Copy to .env and fill in. NEVER commit .env — it holds your bot token.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Telegram (required for posting)
# ---------------------------------------------------------------------------

# QUESTIONS bot — posts quiz questions to the public group. From @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PAYMENTS bots — sell passes, send invites, remove lapsed members.
# One per family of groups, so a student buying either newspaper group talks to
# one bot, either Sadhana APPSC group to another, UPSC to a third and EPFO to a
# fourth. Which group uses which is set by paymentBotEnv in groups.config.json.
TELEGRAM_PAYBOT_NEWS=
TELEGRAM_PAYBOT_SADHANA=
TELEGRAM_PAYBOT_UPSC=
TELEGRAM_PAYBOT_EPFO=

# SUPPORT CHAT — optional. Where tickets from /support are posted, so admins can
# answer by replying to them in Telegram. Without it tickets still go to the
# "Support" tab of the sheet and the dashboard's Support page.
# Create a PRIVATE group for admins only (everyone in it can answer students and
# change bot settings), add each payment bot to it, and put its id here.
# Privacy mode can stay on: bots always receive replies to their own messages.
SUPPORT_CHAT_ID=
# Per-family override, named after the payment bot, e.g. SUPPORT_CHAT_UPSC for
# TELEGRAM_PAYBOT_UPSC. Forum topic ids go in SUPPORT_THREAD_ID / SUPPORT_THREAD_UPSC.
# SUPPORT_CHAT_UPSC=
# SUPPORT_THREAD_ID=
# The daily job posts a support summary to each support chat every morning.
# Set to off to stop it.
# SUPPORT_DAILY_SUMMARY=off

# Fallback used by any payment bot above that has no token of its own, so the
# split can happen one bot at a time rather than all at once.
# Create a SECOND bot with @BotFather and put its token here.
# WHY TWO BOTS: the payment bot must be an admin of the private paid group with
# "Invite Users via Link" and "Ban Users" rights. Giving those to the bot that
# also posts publicly means one leaked token exposes both the question bank and
# the paid group. Separate tokens also mean restarting one never interrupts the
# other, so a posting deploy cannot stop students from buying.
# If left blank, TELEGRAM_BOT_TOKEN is used for both and everything still works.
TELEGRAM_PAYMENT_BOT_TOKEN=

# Supergroup chat id, starts with -100. Add @raw_data_bot to the group to find it.
TELEGRAM_GROUP_ID=-100xxxxxxxxxx

# ---------------------------------------------------------------------------
# 2. Groups
# ---------------------------------------------------------------------------
# Which groups exist, and what each charges, is in groups.config.json. Their
# secrets are here, one set per group, keyed by that group's envPrefix.
#
# For a group with envPrefix UPSC:
#   SHEET_URL_UPSC=https://script.google.com/macros/s/AKfycb.../exec
#   SHEET_TOKEN_UPSC=<that sheet's API_TOKEN script property>
#   TELEGRAM_GROUP_UPSC=-100xxxxxxxxxx
#   RAZORPAY_PLAN_UPSC=plan_xxx        # only for the recurring pass
#
# Each group needs its OWN Apps Script deployment, bound to its own sheet, with
# its own API_TOKEN. Sharing a token between groups would let a routing mistake
# write one group's questions into another's sheet.
#
# LEGACY_GROUP_ID names the group that inherits the original single-sheet
# setup below, so the running system keeps working while the other groups are
# added one at a time. Remove it once every group has its own variables.
LEGACY_GROUP_ID=appsc_q_en

# ---------------------------------------------------------------------------
# 2a. Direct Google Sheets API (recommended — makes posting fast and reliable)
# ---------------------------------------------------------------------------
# With these set, posting reads and writes the sheet through the Google Sheets
# API instead of the Apps Script Web App: under a second a call instead of
# 3–35s, and none of the Web App's intermittent 404s. Uploads, analytics,
# members and support still use the Apps Script.
#
# 1. Google Cloud Console > enable "Google Sheets API" > create a service
#    account > Keys > Add key > JSON.
# 2. Share every sheet with the service account's email as Editor.
# 3. Put the whole key file here on ONE line, in single quotes (or base64 it).
#    On Vercel:  vercel env add GOOGLE_SERVICE_ACCOUNT_JSON production < key.json
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# Each group's spreadsheet id, from its link: docs.google.com/spreadsheets/d/<ID>/edit
# (pasting the whole link also works). A group without one keeps using the Apps Script.
# SHEET_ID_UPSC=1Wa2J_...

# ---------------------------------------------------------------------------
# 2b. Original single-group settings (used by LEGACY_GROUP_ID only)
# ---------------------------------------------------------------------------

# The deployed Apps Script Web App URL. Must be the /exec deployment URL on
# script.google.com — the server rejects anything else.
# Deploy google_apps_script.js: Extensions > Apps Script > Deploy > Web App,
# Execute as "Me", Who has access "Anyone".
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec

# Shared secret that authenticates this server to the Apps Script.
# WHY THIS MATTERS: the Web App is deployed as "Anyone", so without a token the
# /exec URL is effectively the password to your entire question bank — anyone
# who sees it can read every question and mark rows as posted.
# Set it in BOTH places:
#   1. Apps Script > Project Settings > Script properties > API_TOKEN
#   2. here, as the same value
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHEET_API_TOKEN=

# ---------------------------------------------------------------------------
# 3. Dashboard authentication (required — the API refuses to serve data without it)
# ---------------------------------------------------------------------------

# Firebase project id. Must match the projectId in dashboard/shared.js, or every
# sign-in will be rejected. The server verifies each Firebase ID token against
# Google's public certificates before answering any API request.
FIREBASE_PROJECT_ID=ap-gurukul-43050

# Comma-separated list of curator emails allowed to use the dashboards.
# Leave empty to allow any Firebase account with a VERIFIED email — only do
# that if you have disabled self-registration in the Firebase console.
CURATOR_EMAILS=

# Set to true to show the "Create Account" tab on the sign-in gate.
# Leave false in normal operation: with it on, anyone who can reach the page can
# create an account.
ALLOW_SELF_REGISTRATION=false

# ---------------------------------------------------------------------------
# 4. Server binding (optional)
# ---------------------------------------------------------------------------

# Port for the dashboard server.
PORT=3000

# Interface to bind. Defaults to 127.0.0.1 (this machine only).
# Setting 0.0.0.0 exposes an interface that can post to your Telegram channel
# to every device on your network. Only do it deliberately.
# HOST=127.0.0.1

# ALWAYS OPEN THE DASHBOARD AT http://localhost:3000
# Firebase authorises sign-in per domain and treats "localhost" and "127.0.0.1"
# as different ones; only localhost is authorised by default, so signing in from
# 127.0.0.1 fails with an unexplained 500 from accounts.google.com. The server
# therefore redirects 127.0.0.1 to localhost. Set this to false only if you have
# deliberately added 127.0.0.1 to your Firebase authorised domains.
# CANONICAL_HOST_REDIRECT=true

# ============================================================================
# 5. Razorpay paid group access (optional — only if you sell passes)
# ============================================================================

# Keys from Razorpay Dashboard > Settings > API Keys.
# rzp_test_* keys move no real money. Rotate before going live if a key has
# ever been pasted into a chat, an issue, or a screenshot.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Shared secret for webhook signatures. Must match Razorpay > Settings >
# Webhooks EXACTLY, or every webhook is rejected and nobody gets access after
# paying. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET=

# Razorpay plan id for the recurring pass. Created by `npm run setup-razorpay`.
# The two one-time passes work without it.
RAZORPAY_MONTHLY_PLAN_ID=

# Publicly reachable base URL. Razorpay delivers webhooks here, so it cannot be
# localhost — use your deployed domain, or a tunnel while testing.
PUBLIC_BASE_URL=https://appscsadhana.vercel.app

# Private group paying members are invited into. Defaults to TELEGRAM_GROUP_ID.
# TELEGRAM_PREMIUM_GROUP_ID=-100xxxxxxxxxx

# Fixed end date for the "Till Exam" pass (DD-MM-YYYY).
EXAM_PASS_END_DATE=30-11-2026

# The EPFO pass ends on the EPFO exam, not the APPSC one. Unset, it uses the
# date in groups.config.json (24-12-2026: the exam is 20-12-2026, access runs to the 24th). The "Valid until" date on the
# dashboard's Pass & Coupons page, with the EPFO group selected, wins over both.
# EPFO_PASS_END_DATE=24-12-2026

# The free preview is no longer offered. /api/cron/trials (also run by the
# nightly sweep) only closes previews that were already open; no pinger needed.

# When the nightly expiry sweep runs, for `npm run membership-cron -- --watch`.
# MEMBERSHIP_CRON=0 1 * * *

# Secret for the scheduled expiry sweep at /api/cron/sweep, which Vercel Cron
# calls as `Authorization: Bearer <this>`. Set it in BOTH Vercel's environment
# variables and here. Without it the endpoint refuses to run at all, because an
# unauthenticated URL that removes paying members is not a thing to leave open.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Requests one IP may make in a minute. A curation team behind one office NAT
# shares an address, and so shares one bucket. Scheduled /api/cron/* routes and
# signed webhooks are never counted: they carry their own secrets, and a 429 to
# Vercel Cron is not retried — that run simply does not happen.
# RATE_LIMIT_MAX=240
# RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Influencer programme
# ---------------------------------------------------------------------------
# Influencers apply in their own bot, an admin approves them on the dashboard's
# Influencers page with the terms of their choosing, and each gets a promo code
# that works only in the payment bot of the exam they were approved for.
#
# The bot: create it with @BotFather. Add it to the admin chat below (it posts
# new applications and withdrawal requests there), then run `npm run set-webhooks`
# and `npm run bot-profile`.
# TELEGRAM_AFFILIATE_BOT=
#
# The sheet: a blank Google Sheet of its own, shared with the service account
# (GOOGLE_SERVICE_ACCOUNT_JSON) as an Editor. Its tabs are created on first use.
# The id from its link, or the whole link.
# AFFILIATE_SHEET_ID=
#
# The influencer bot's @name, for the button in the payment bots' /affiliate
# message. Blank asks Telegram for it once per instance.
# AFFILIATE_BOT_USERNAME=
#
# Where admin alerts go. Blank uses SUPPORT_CHAT_ID (and SUPPORT_THREAD_ID).
# AFFILIATE_ADMIN_CHAT_ID=
# AFFILIATE_ADMIN_THREAD_ID=

# ---------------------------------------------------------------------------
# Autopilot — unattended "every N minutes, post M questions"
# ---------------------------------------------------------------------------
# Started and stopped from the Automation dashboard, so none of these have to
# be set. They are the ceilings the job runs inside.

# Which subjects were running when the server last stopped, so a restart picks
# them back up. Set it to an empty value to keep nothing at all; it is ignored
# on Vercel, where the filesystem does not survive between requests.
# AUTOPILOT_STATE_FILE=.autopilot-state.json

# How often the scheduler looks for a job that is due. It is a poll, not the
# interval itself: a job asking for "every 5 minutes" fires within this of its
# due time.
# AUTOPILOT_TICK_MS=15000

# Wall-clock ceiling on one unattended batch. Shorter than a manual run's
# POST_BUDGET_MS: nobody is watching, and a run that overruns its own interval
# is worse than one that stops early and sends the rest next time.
# AUTOPILOT_RUN_BUDGET_MS=120000

# How many posted questions the deleted-poll check looks at in one pass, and
# how long it may spend. Each row is one Telegram call plus a rate-limit pause,
# so a whole channel cannot be swept at once — later passes carry on from where
# the last one stopped.
# AUTOPILOT_RECONCILE_LIMIT=40
# AUTOPILOT_RECONCILE_BUDGET_MS=60000

# Set to true to expose the Rs 1 / 5-minute test pass in the bot menu. It exists
# to prove the expiry sweep and the removal actually work without waiting out a
# 30-day pass. LEAVE THIS UNSET IN NORMAL OPERATION: with it on, anyone who
# finds the bot can buy access for a rupee.
# TEST_PLAN_ENABLED=true
